# Local vision service. Keep these server-side (do not prefix with VITE_).
OLLAMA_HOST=http://127.0.0.1:11434
CALENDAR_VISION_MODEL=qwen2.5vl:3b

# Real adult accounts. Node 22.13+ is required. Keep these server-side.
# Defaults to .data/auth.sqlite; preserve this file across server restarts.
# AUTH_DATABASE_PATH=.data/auth.sqlite
# Set the exact public HTTPS origin when deployed behind an HTTPS reverse proxy.
# AUTH_ORIGIN=https://your-boblii-domain.example
# AUTH_SECURE_COOKIES=true
# HOST=127.0.0.1
# PORT=5174
